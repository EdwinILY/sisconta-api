generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT
}

enum ChargeType {
  FIXED
  PERCENTAGE
}

enum RequestStatus {
  PENDING
  DOCUMENTS_UPLOADED
  BIOMETRIC_VALIDATED
  APPROVED
  REJECTED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               Role     @default(CLIENT)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  investmentRequests InvestmentRequest[]
  creditSimulations  CreditSimulation[]
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  ruc       String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTypes CreditType[]
}

model CreditType {
  id                    String   @id @default(uuid())
  name                  String   @unique
  minAmount             Float
  maxAmount             Float
  annualInterestRate    Float
  amortizationSystems   String[]
  institutionId         String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  indirectCharges   IndirectCharge[]
  simulations       CreditSimulation[]
}

model IndirectCharge {
  id           String     @id @default(uuid())
  name         String
  type         ChargeType @default(FIXED)
  value        Float
  mandatory    Boolean    @default(false)
  creditTypeId String
  createdAt    DateTime   @default(now())

  creditType CreditType @relation(fields: [creditTypeId], references: [id], onDelete: Cascade)
}

model CreditSimulation {
  id                 String   @id @default(uuid())
  userId             String
  creditTypeId       String
  amount             Float
  termMonths         Int
  amortizationSystem String   // "FRENCH" o "GERMAN"
  paymentSchedule    Json     // Tabla de pagos completa
  totalPayment       Float
  totalInterest      Float
  totalCharges       Float    // Suma de cobros indirectos
  createdAt          DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditType CreditType @relation(fields: [creditTypeId], references: [id])

  @@index([userId])
  @@index([creditTypeId])
}

model InvestmentProduct {
  id                 String   @id @default(uuid())
  name               String
  purpose            String?
  minAmount          Float
  maxAmount          Float
  minTermMonths      Int
  maxTermMonths      Int
  annualRate         Float
  allowOutOfMargin   Boolean  @default(false)
  capitalizationFreq String   @default("MONTHLY")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  investmentRequests InvestmentRequest[]
}

model InvestmentRequest {
  id              String         @id @default(uuid())
  userId          String
  productId       String
  amount          Float
  termMonths      Int
  status          RequestStatus  @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             InvestmentProduct   @relation(fields: [productId], references: [id])
  documents           InvestmentDocument[]
  biometricVerification BiometricVerification?
}

model InvestmentDocument {
  id                String   @id @default(uuid())
  investmentRequestId String
  type              String   // "IDENTITY", "INCOME_PROOF", "BANK_STATEMENT"
  fileUrl           String
  uploadedAt        DateTime @default(now())

  investmentRequest InvestmentRequest @relation(fields: [investmentRequestId], references: [id], onDelete: Cascade)

  @@index([investmentRequestId])
}

model BiometricVerification {
  id                String   @id @default(uuid())
  investmentRequestId String  @unique
  status            String   @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  modality          String   @default("FACE")    // FACE, FINGERPRINT, VOICE
  metadata          Json?                        // Datos adicionales mock
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())

  investmentRequest InvestmentRequest @relation(fields: [investmentRequestId], references: [id], onDelete: Cascade)
}